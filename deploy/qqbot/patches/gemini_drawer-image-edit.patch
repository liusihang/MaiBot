+async def resolve_reference_message_images(
+    message_ids: List[str], stream_id: str, ctx: Any,
+    proxy: Optional[str] = None, logger=None,
+) -> List[bytes]:
+    """Read explicit reference messages from the current session; never guess a source."""
+    if not isinstance(message_ids, list) or not 1 <= len(message_ids) <= 4:
+        raise ValueError("参考图消息 ID 需要提供1至4条")
+    if not stream_id or not ctx or not getattr(ctx, "message", None):
+        raise ValueError("缺少当前会话或消息读取能力，未提交图片编辑")
+    images: List[bytes] = []
+    seen = set()
+    for raw_id in message_ids:
+        if not isinstance(raw_id, str) or not raw_id.strip():
+            raise ValueError("参考图消息 ID 必须是非空字符串")
+        message_id = raw_id.strip()
+        if message_id in seen:
+            continue
+        seen.add(message_id)
+        message = await ctx.message.get_by_id(
+            message_id, stream_id=stream_id, include_binary_data=True,
+        )
+        if not isinstance(message, dict):
+            raise ValueError(f"当前会话中未找到参考图消息 {message_id}，编辑未提交")
+        found = await extract_images_from_segments(_message_dict_segments(message), proxy, logger)
+        if not found:
+            raise ValueError(f"未读到消息 {message_id} 的原图文件，编辑未提交")
+        if len(images) + len(found) > MAX_MESSAGE_IMAGES:
+            raise ValueError("参考图数量超过插件上限，编辑未提交")
+        images.extend(found)
+    return images
